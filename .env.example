# =====================================================
#  Kredensial untuk container MySQL (service `mysql`)
#  Salin file ini menjadi .env lalu sesuaikan nilainya.
#  Nilai di bawah dipakai BERSAMA oleh container mysql
#  (untuk membuat db/user) dan aplikasi PHP (untuk koneksi).
# =====================================================

MYSQL_DATABASE=app_db
MYSQL_USER=app_user
MYSQL_PASSWORD=app_password
MYSQL_ROOT_PASSWORD=root_password
